-  if (event.data === 1) { // PLAYING
-    startPlayerTimeSync();
-  } else {
-    stopPlayerTimeSync();
-  }
-
-  if (event.data === 0) { // ENDED
-    if (isAutoAdvanceEnabled && activeAllocation && !isAutoAdvancing) {
-      triggerAutoAdvance();
