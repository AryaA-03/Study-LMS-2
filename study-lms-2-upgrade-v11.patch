-    if (!isYtReady || !ytPlayer || !ytPlayer.getCurrentTime) return;
-    try {
-      const curTime = ytPlayer.getCurrentTime();
-      syncLiveNoteTimestamp(curTime);
-
-      // Auto-advance check at slice boundary
