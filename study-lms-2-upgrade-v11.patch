+
+import { ModalShell } from './ModalShell';
+const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
+
+export const EditCourseModal: React.FC<{
+  course: Course;
+  onClose: () => void;
+  onSaved: () => void;
+  onDeleted: () => void;
+  onToast: (msg: string) => void;
