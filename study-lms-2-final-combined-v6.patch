+                className={`flex items-center justify-center gap-1 rounded-md py-1.5 font-semibold transition ${
+                  tab === t.id ? 'bg-[var(--accent)] text-white' : 'text-[var(--fg-secondary)]'
+                }`}
+              >
+                <Icon className="h-3.5 w-3.5" /> {t.label}
