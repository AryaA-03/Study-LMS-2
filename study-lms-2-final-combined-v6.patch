+              placeholder="Or search YouTube playlists/lectures (Approval Gate)..."
+              className="flex-1 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-card)] px-3 py-1.5 text-[var(--fg-primary)] outline-none"
