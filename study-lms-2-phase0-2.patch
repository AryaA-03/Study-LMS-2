+def isolate_runtime_paths(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
+    """Redirect DATA_DIR, DB_PATH, and BACKUPS_DIR to an isolated tmp_path per test."""
+    test_data_dir = tmp_path / "data"
